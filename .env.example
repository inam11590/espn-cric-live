# CricStream Live Environment Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database
DATABASE_URL=sqlite:///cricket_streams.db

# Scraper & Caching
SCRAPE_INTERVAL_SECONDS=20
SCRAPE_TIMEOUT_SECONDS=25
CACHE_LIVE_TTL=20
CACHE_DETAIL_TTL=86400

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET_KEY=cricstream-jwt-secret-key-production-2026-secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440
