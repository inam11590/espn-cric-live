# ==============================================================================
# CricStream Live - Production Environment Configuration
# Copy this file to .env.production on your Linux VPS before deploying.
# ==============================================================================

# Public Domain Name and SSL Notification Email
DOMAIN_NAME=cricket.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Server & Database
DATABASE_URL=sqlite:////app/data/cricket.db
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Cricinfo Scraper & Background Cache Guardrails
SCRAPE_INTERVAL_SECONDS=20
SCRAPE_TIMEOUT_SECONDS=25
CACHE_LIVE_TTL=20
CACHE_DETAIL_TTL=86400

# Admin Portal Credentials
# Change these to strong credentials for production access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_in_production

# JWT Security
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_secure_random_64_character_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
